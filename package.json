{
  "name": "thegoatchick",
  "version": "2.1.2-rc2",
  "description": "watch twitch chat and do stuff",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "standard",
    "test": "standard && cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "start": "cross-env NODE_ENV=production node src/goats.js",
    "debug": "cross-env NODE_ENV=development nodemon --inspect src/goats.js",
    "build": "exec sudo docker build . -t brainswax/thegoatchick:$npm_package_version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brainswax/thegoatchick.git"
  },
  "author": "brainswax",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/brainswax/thegoatchick/issues"
  },
  "homepage": "https://github.com/brainswax/thegoatchick#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "cross-env": "^10.1.0",
    "custom-env": "^2.0.6",
    "obs-websocket-js": "^5.0.8",
    "onvif": "^0.7.4",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "standard": "^17.1.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
